# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=booru
POSTGRES_PASSWORD=booru
POSTGRES_DB=booru

# Media files
MEDIA_ROOT=/data/media
MEDIA_CONCURRENCY=2
# Optional override; defaults to CPU cores divided by MEDIA_CONCURRENCY.
# ONNX_INTRA_THREADS=4

# Other settings
DEV_MODE=true
RUN_INTEGRATION_TESTS=0

# Embeddings
# Leave MODEL_DIR empty to enable runtime downloads into MODEL_CACHE_DIR
MODEL_CACHE_DIR=/cache/models
MODEL_NAME=Siglip2_FP16
MODEL_REPOSITORY=onnx-community/siglip2-base-patch16-224-ONNX
MODEL_REVISION=main
# MODEL_FILES=vision_model_fp16.onnx|onnx/vision_model_fp16.onnx|<sha>,...
