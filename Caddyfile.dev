:80 {
    handle /api/* {
        reverse_proxy app:8080
    }

    handle /files/* {
        header Cache-Control "no-cache, no-store, must-revalidate"
        reverse_proxy app:8080
    }

    handle /* {
        # Caddy handles WebSocket upgrades automatically.
        reverse_proxy web:5173
    }

    respond "Not Found" 404
}
